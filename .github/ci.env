# Placeholder configuration for the CI container smoke test (.github/workflows/ci.yml, docker job).
# Not a secret and never used outside a throwaway CI runner: the stack starts, answers its health
# endpoint and is torn down. The database password, the key-encryption key and the session secret
# are generated at run time by the workflow, so no secret-shaped value is committed here. No
# service key is set: CI never calls CompTox, Census, OpenAI or Logfire.
POSTGRES_USER=ecofate
POSTGRES_DB=ecofate
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=EcoFate <no-reply@ecofate.local>
