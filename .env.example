# Copy this file to .env and fill it in.
# .env is gitignored so your keys stay out of the repo.

# Command line only (`python -m app`, the evaluations). The web program never reads it: every
# user saves their own OpenAI key in Settings (bring your own key), stored encrypted per account.
OPENAI_API_KEY=your-openai-key-here

# Key-encryption key for the users' OpenAI keys. Required for the web program: it refuses to start
# without it. 32 random bytes, base64url; generate one with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Losing it makes every stored key unreadable (users save theirs again). Never commit a real one.
ECOFATE_KEY_ENCRYPTION_KEY=your-generated-key-encryption-key-here
# During a rotation only: the old key, until `python -m api rotate-keys` has re-sealed every row.
# ECOFATE_KEY_ENCRYPTION_KEY_PREVIOUS=

# The operator's service keys: users never see or enter them.
# EPA CompTox Chemicals Dashboard API key (request one from the CTX API team).
COMPTOX_API_KEY=your-comptox-api-key-here

# U.S. Census Bureau API key, free: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your-census-key-here

# Pydantic Logfire monitoring (optional; set once by whoever installs the app, never by users).
# Write token: lets runs send their traces. Without it nothing leaves the machine.
# Read token: lets the Monitoring view read traces back. Both come from the Logfire project.
# LOGFIRE_TOKEN=your-logfire-write-token-here
# LOGFIRE_READ_TOKEN=your-logfire-read-token-here

# Docker (`docker compose up`): the operator's keys above (Census, CompTox, Logfire, the
# key-encryption key) are read from this file. Compose passes it to the container at run time; it
# is never copied into the image. Users' OpenAI keys are never here.

# PostgreSQL (the conversations). `docker compose` creates the `db` service with these three
# values and builds the services' DATABASE_URL from them. Use a long random password made of
# letters and digits only (it goes into a URL).
POSTGRES_USER=ecofate
POSTGRES_PASSWORD=change-me-long-random-letters-and-digits
POSTGRES_DB=ecofate

# Native runs (`make db && make migrate`, then `uv run python -m api`): the same database on
# the host's loopback, built from the three values above (python-dotenv expands them). Inside
# compose this value is replaced by one that points at the `db` service.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}

# Redis: the queue of chat turns for the background worker and each turn's live events. Inside
# compose this value is replaced by one that points at the `redis` service. Native runs: start it
# with `make redis`, run the API (`uv run python -m api`) and a worker
# (`uv run celery -A worker.celery_app worker`). Without Redis, set `[worker].eager = true` in
# config/settings.toml to run turns inside the API process instead.
REDIS_URL=redis://127.0.0.1:6379/0

# Accounts. Required and deliberately empty here: the web program refuses to start until you set it.
# A random secret of at least 32 characters; it keys the stored hashes of session cookies and
# emailed links. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and voids pending links.
ECOFATE_SESSION_SECRET=

# Outgoing email (verification and password-reset links): the SMTP server, configured only here.
# Required: the web program refuses to start without SMTP_HOST, SMTP_PORT, SMTP_SECURITY and
# SMTP_FROM. SMTP_SECURITY is starttls (port 587), tls (implicit TLS, port 465) or none (a local
# mail catcher only; a login is refused without encryption). README "Email: development and
# production" explains both setups.
#
# DEVELOPMENT (the values below): every email goes to Mailpit, the local mail catcher started by
# `docker compose --profile dev up`. Nothing reaches a real inbox: read the mail at
# http://127.0.0.1:8025. The same values work for Docker and native runs (inside the container a
# loopback SMTP_HOST means the `mailpit` service).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=EcoFate <no-reply@ecofate.local>
#
# PRODUCTION: replace the six lines above with your provider's values; the sender must be an
# address on a domain the provider has verified. For example:
#   Cloudflare Email Service (domain on Cloudflare DNS, onboarded for Email Sending):
#     SMTP_HOST=smtp.mx.cloudflare.net
#     SMTP_PORT=465
#     SMTP_SECURITY=tls
#     SMTP_USERNAME=api_token                  (literally this text)
#     SMTP_PASSWORD=<API token with Email Sending: Edit>
#     SMTP_FROM=EcoFate <no-reply@yourdomain.com>
#   Any provider on port 587 (Amazon SES, Resend, Gmail with an app password, ...):
#     SMTP_HOST=<provider host>  SMTP_PORT=587  SMTP_SECURITY=starttls
#     SMTP_USERNAME=<login>  SMTP_PASSWORD=<password or API key>  SMTP_FROM=EcoFate <no-reply@yourdomain.com>
