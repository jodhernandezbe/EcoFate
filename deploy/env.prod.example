# Template for the VM file /opt/ecofate/.env.prod (mode 0600, owner ecofate). Names only:
# fill the values on the VM itself and keep a copy in your password manager; never commit them,
# never paste them into GitHub. deploy/deploy.sh refuses to deploy while any uncommented name
# below is missing or empty in .env.prod (it names the variable, never prints a value).
# DATABASE_URL and REDIS_URL are not here: compose builds them for the containers.
# OPENAI_API_KEY is not here: on the web program every user brings their own key.

# PostgreSQL (the `db` service). Letters and digits only for the password (it goes into a URL):
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Key-encryption key for the users' stored OpenAI keys (32 random bytes, base64url). Losing it
# makes every stored key unreadable:
#   python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ECOFATE_KEY_ENCRYPTION_KEY=

# Keys the stored hashes of session cookies and emailed links (at least 32 characters):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ECOFATE_SESSION_SECRET=

# The operator's data-service keys (users never see them).
COMPTOX_API_KEY=
CENSUS_API_KEY=

# Outgoing email through Cloudflare Email Service (docs/deployment.md, "Email"):
#   SMTP_HOST=smtp.mx.cloudflare.net  SMTP_PORT=465  SMTP_SECURITY=tls
#   SMTP_USERNAME=api_token (literally)  SMTP_PASSWORD=<API token with Email Sending: Edit>
# Fallback, Resend's free tier: SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_SECURITY=starttls
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# The Object Storage bucket the nightly dumps go to (the one provision.sh created; not secret).
ECOFATE_BACKUP_BUCKET=

# Optional: Pydantic Logfire monitoring (traces and the admin Monitoring view).
# LOGFIRE_TOKEN=
# LOGFIRE_READ_TOKEN=
