# Copy to deploy/oci/config.env (git-ignored) and fill in; read by provision.sh and teardown.sh.
# The OCI CLI itself is configured with `oci setup config` (region and API key in ~/.oci/config).

# Compartment that holds every resource (the tenancy's root compartment OCID is fine for one app).
OCI_COMPARTMENT_OCID=
# Tenancy OCID: dynamic groups and policies are created at the tenancy level.
OCI_TENANCY_OCID=

# The VM. Always Free allows up to 4 OCPUs and 24 GB of memory in total on Ampere A1, and 200 GB
# of block storage; provision.sh refuses anything larger before creating a resource.
OCI_OCPUS=4
OCI_MEMORY_GB=24
OCI_BOOT_VOLUME_GB=100
# Public key for the `ecofate` user's emergency access through the Cloudflare tunnel (no inbound
# port is ever opened). Not the deploy key: that one is added later (docs/deployment/deploy-key-and-github.md).
OCI_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Your public IP as a /32 (e.g. 203.0.113.7/32): the only address the OCI Bastion accepts. The
# Bastion is how you reach the VM before the Cloudflare tunnel exists (and in an emergency).
OCI_BASTION_CLIENT_CIDR=

# Object Storage bucket for the nightly database dumps (private; dumps kept 30 days).
OCI_BACKUP_BUCKET=ecofate-backups

# How long to keep retrying when Ampere A1 capacity is short ("Out of host capacity"), per
# attempt across all availability domains, and how many attempts.
OCI_CAPACITY_RETRY_SECONDS=300
OCI_CAPACITY_ATTEMPTS=12
